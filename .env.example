# Agent Games — environment configuration.
# Copy to .env and fill in. NEVER commit a filled .env (it is git-ignored).
# All values here are placeholders only.

# Port / host for the agent HTTP server. Behind a reverse proxy / hosting
# provider this is plain HTTP; the PUBLIC address must be HTTPS (the
# platform requires a public HTTPS endpoint).
PORT=3000
HOST=0.0.0.0

# HMAC secret issued by the Agent Games platform (Dashboard -> Rotate Secret).
# 32-byte random secret, shown exactly once. REQUIRED in live mode.
# Without it the server runs in DEMO mode and skips HMAC verification
# (local testing only — never deploy demo mode).
AGENT_GAMES_HMAC_SECRET=

# Submission provider: "offline" (default, demo: proofs are verified locally
# and stored, nothing leaves the machine) or "kurier" (submit to zkVerify
# via Kurier REST and poll to Finalized).
SUBMISSION_PROVIDER=offline

# Kurier API key (https://kurier.xyz for mainnet, https://testnet.kurier.xyz
# for testnet). Required only when SUBMISSION_PROVIDER=kurier.
KURIER_API_KEY=
# Kurier environment: "mainnet" or "testnet".
KURIER_NETWORK=testnet

# Directory where the agent persists seen proof references (PROOF_REUSED
# detection) and per-task responses (idempotency). Defaults to ./data.
DATA_DIR=./data

# Gatekeeper proof salt. A per-agent private field element used to bind each
# proof to its task (the official gatekeeper circuit takes `salt` as a
# private input). Any non-negative integer below the BN128 field prime works;
# keep it stable per agent. Default: 0.
GATEKEEPER_SALT=0
